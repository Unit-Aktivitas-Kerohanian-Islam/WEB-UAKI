# ==============================================================================
# ENVIRONMENT & SERVER SETTINGS
# ==============================================================================
GO_ENV=development
PORT=3000

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Jika berjalan di luar Docker (akses local db): gunakan 127.0.0.1
# Jika berjalan di dalam container Docker (docker compose): gunakan 'db'
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Smaira123!
DB_DATABASE=backend_server_development
TEST_DATABASE_URL=postgres://postgres:Smaira123!@127.0.0.1:5432/backend_server_test?sslmode=disable

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET_KEY=super_secret_jwt_key_change_me_1234567890
JWT_EXP_TIME=86400

# ==============================================================================
# OBJECT STORAGE CONFIGURATION (Biznet NEO Object Storage / S3-Compatible)
# ==============================================================================
# S3 Endpoint Biznet NEO Jakarta Region
# Dapatkan Access Key & Secret Key dari: portal.biznetgio.com > Storage & Backup > NEO Object Storage > Access
NOS_ENDPOINT=https://nos.jkt-1.neo.id
NOS_ACCESS_KEY=your_access_key_here
NOS_SECRET_KEY=your_secret_key_here
NOS_BUCKET=your_bucket_name_here
NOS_REGION=jkt-1
